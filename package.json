{
  "name": "erp-insurance",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "npm run build:sw",
    "start": "ng serve",
    "prebuild": "npm run build:sw",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:sw": "tsc -p tsconfig.sw.json && esbuild src/app/core/workers/offline/medical-offline.sw.ts --bundle --format=iife --target=es2022 --minify --outfile=public/medical-offline.sw.js"
  },
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.9",
    "@angular/cli": "^21.2.9",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "esbuild": "0.28.1",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
